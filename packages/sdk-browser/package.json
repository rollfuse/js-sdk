{
  "name": "@rollfuse/sdk-browser",
  "version": "0.1.2",
  "description": "Browser SDK that evaluates Growth Operations Platform feature flags directly in client-side JavaScript using a Public Credential (never a regular Service Credential), reusing @rollfuse/evaluation-core's deterministic bucketing/evaluation algorithm.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@rollfuse/contracts": "^0.2.2",
    "@rollfuse/evaluation-core": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
