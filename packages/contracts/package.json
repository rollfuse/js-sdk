{
  "name": "@growth-ops/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from apps/api/openapi/openapi.yaml, for consumption by @growth-ops/sdk-js and other TypeScript clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/openapi.d.ts"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi/openapi.yaml -o src/openapi.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
