{
  "name": "@rollfuse/contracts",
  "version": "0.6.1",
  "description": "TypeScript types generated from openapi/openapi.yaml (a checked-in mirror of the rollfuse platform's OpenAPI document), for consumption by @rollfuse/sdk-js and other TypeScript clients.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi/openapi.yaml -o src/openapi.d.ts && node scripts/extract-schemas.mjs",
    "build": "tsc -p tsconfig.json && cp src/openapi.d.ts dist/openapi.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "js-yaml": "5.4.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10"
  }
}
