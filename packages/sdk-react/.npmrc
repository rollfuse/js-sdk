save-exact=true
# Blocks dependency lifecycle scripts (preinstall/install/postinstall) by
# default — see openspec/specs/dependency-supply-chain-security/spec.md for
# the "Blocked Install Scripts By Default" requirement. No dependency here
# currently needs an install script. If one legitimately does (e.g. a
# native-binary package like sharp, esbuild, or playwright), add it to an
# explicit allowlist here with a comment naming the dependency and why the
# script is required, reviewed like any other dependency change.
ignore-scripts=true
